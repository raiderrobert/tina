# Tina reads credentials from the environment. Only the adapters a track
# actually uses need to be populated.

# --- Jira source (source = "jira") ---------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@your-org.example
JIRA_API_TOKEN=
# Atlassian account id of the bot user. Claiming assigns the issue to it.
# Optional — looked up via GET /rest/api/3/myself when unset.
JIRA_BOT_ACCOUNT_ID=

# --- GitHub Issues source (source = "github") ----------------------------
# Needs repo scope: read issues, assign issues. GH_TOKEN (the GitHub CLI's
# spelling) is accepted when GITHUB_TOKEN is unset.
GITHUB_TOKEN=
# Deployments minting short-lived tokens (GitHub App installation tokens)
# name the command whose stdout is the current one instead. It is run to
# start and again when GitHub answers 401 mid-run, then the request retried.
#GITHUB_TOKEN_COMMAND="my-credential-helper github-token"
# Login of the bot user. Optional — looked up via GET /user when unset.
GITHUB_BOT_LOGIN=

# --- Control plane (read by `tina dispatch` only) -------------------------
# Path of the control file holding runtime policy (paused, max_concurrency).
# Overrides the `control` key in tina.toml. See docs/control.md.
#TINA_CONTROL=/mnt/config/control.toml
# Raw TOML policy, for runners where mounting a file is awkward. Wins over
# TINA_CONTROL.
#TINA_CONTROL_INLINE=

# --- Paths ---------------------------------------------------------------
# Override the config location and the config's paths, so one image runs
# against a config mounted anywhere. Each is optional.
#TINA_CONFIG=/mnt/config/tina.toml
#TINA_TRACKS_DIR=/app/tracks
#TINA_ARTIFACTS_DIR=/mnt/artifacts

# --- Harness -------------------------------------------------------------
# Seconds before Tina kills the agent subprocess. Default 3600.
TINA_HARNESS_TIMEOUT=3600

# Credentials the *agent* needs to do the work (open PRs, write Confluence,
# ...) also live here. Tina does not read them; it only passes the environment
# through to the harness subprocess, and reuses them for artifact verification.
